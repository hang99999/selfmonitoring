LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=gpt-4o
# Retry counts are extra attempts after the first call.
# LLM_MAX_RETRIES=4 means 5 total primary-model attempts.
LLM_MAX_RETRIES=4
LLM_FALLBACK_MODEL=deepseek-v4-flash
# LLM_FALLBACK_RETRIES=1 means 2 total fallback-model attempts.
LLM_FALLBACK_RETRIES=1
DATABASE_URL=sqlite:///./lv_cbt.db

# LLM provider settings live here as before.

# RevenueCat webhook settings.
# Set this to the exact Authorization header value configured in RevenueCat,
# or to the token part if RevenueCat sends "Bearer <token>".
REVENUECAT_WEBHOOK_AUTH=change-me
REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
